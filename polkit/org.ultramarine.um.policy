<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-FileCopyrightText: 2026 Cypress Reed <cypress@fyralabs.com> -->
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<policyconfig>
  <vendor>Ultramarine Linux</vendor>
  <vendor_url>https://ultramarine-linux.org</vendor_url>
  <!--
    Only covers `um tweaks ...` (argv1 = tweaks). Other um commands that
    escalate through pkexec fall back to the generic
    org.freedesktop.policykit.exec action. exec.path must be the canonical
    path of the binary: pkexec resolves symlinks before matching, so
    /usr/bin/um has to be the real file, not a symlink.
  -->
  <action id="org.ultramarine.um.tweaks">
    <description>Manage system tweaks</description>
    <message>Authentication is required to change system tweaks</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/um</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">tweaks</annotate>
  </action>
</policyconfig>
